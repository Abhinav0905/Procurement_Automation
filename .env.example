# ── runtime ──────────────────────────────────────────────────────────────────
APP_ENV=local                    # local | test | dev | staging | prod
LOG_LEVEL=INFO
LOG_FORMAT=console               # console for humans, json for shipping
DEFAULT_TENANT_ID=ACME-MFG

# ── CockroachDB ──────────────────────────────────────────────────────────────
# The cockroachdb+psycopg dialect is required: the stock PostgreSQL dialect
# cannot parse CockroachDB's version() string.
DATABASE_URL=cockroachdb+psycopg://root@localhost:26257/procureguard?sslmode=disable
DB_POOL_SIZE=10
DB_MAX_RETRIES=5                 # 40001 serialization failures are normal
VECTOR_BACKEND=auto              # auto | native | json

# ── object store ─────────────────────────────────────────────────────────────
OBJECT_STORE_BACKEND=local       # local | s3
S3_BUCKET=procureguard-documents
S3_INBOUND_EMAIL_BUCKET=procureguard-inbound-email
S3_KMS_KEY_ID=
AWS_REGION=us-west-2

# ── language model ───────────────────────────────────────────────────────────
# deterministic runs the full pipeline with no model and no credentials. The
# model is a supplement to the deterministic parsers, never a dependency.
LLM_BACKEND=deterministic        # deterministic | bedrock
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
BEDROCK_FAST_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=

# ── embeddings ───────────────────────────────────────────────────────────────
# EMBEDDING_DIMENSIONS is part of the schema. Changing it means re-embedding
# every indexed chunk, so decide before the first production load.
EMBEDDING_BACKEND=hashing        # hashing | bedrock
EMBEDDING_DIMENSIONS=256         # 1024 with Titan

# ── email ────────────────────────────────────────────────────────────────────
EMAIL_BACKEND=filesystem         # filesystem | smtp | ses
EMAIL_FROM_ADDRESS=procurement@procureguard.example.com
EMAIL_FROM_NAME=ACME Manufacturing Procurement
EMAIL_REPLY_TO_DOMAIN=rfq.procureguard.example.com
SMTP_HOST=localhost
SMTP_PORT=1025                   # MailHog, via `make up`
IMAP_HOST=
IMAP_USERNAME=
IMAP_PASSWORD=

# ── Temporal ─────────────────────────────────────────────────────────────────
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=procureguard-procurement
TEMPORAL_API_KEY=

# ── procurement policy ───────────────────────────────────────────────────────
MAX_RFQ_REMINDERS=2
REMINDER_INTERVAL_HOURS=72
QUOTE_WINDOW_DAYS=10
MIN_SUPPLIERS_PER_RFQ=3
MAX_SUPPLIERS_PER_RFQ=6
MIN_QUOTES_TO_EVALUATE=2
MAX_NEGOTIATION_ROUNDS=3
NEGOTIATION_TARGET_SAVINGS_PCT=7.5
DUAL_APPROVAL_THRESHOLD=50000
EXECUTIVE_APPROVAL_THRESHOLD=250000
PRICE_INCREASE_ALERT_PCT=10

# ── financial ────────────────────────────────────────────────────────────────
BASE_CURRENCY=USD
WACC_ANNUAL_PCT=9.0             # prices payment terms into the comparison
INVENTORY_CARRYING_COST_ANNUAL_PCT=18.0
DEFAULT_DUTY_RATE_PCT=0

# ── security ─────────────────────────────────────────────────────────────────
# dev trusts X-Actor-Id / X-Actor-Roles headers and is refused when APP_ENV=prod.
AUTH_MODE=dev                    # dev | oidc | static
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
STATIC_API_KEYS=                 # key:actor_id:ROLE1|ROLE2,...
SESSION_SECRET=local-development-secret-do-not-use-in-production
ENCRYPTION_BACKEND=local         # local | kms
KMS_KEY_ID=
SEALED_BID_ENABLED=true

# ── safety switches (both off by default) ────────────────────────────────────
# false: the agent drafts a complete message and stores it for human release.
ALLOW_AUTOMATED_EMAIL_SEND=false
# false: ProcureGuard emits a draft PO and an SAP payload; a human releases it.
ALLOW_AUTOMATED_PO_CREATION=false

# ── observability ────────────────────────────────────────────────────────────
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=

# ── seeding ──────────────────────────────────────────────────────────────────
SEED_RANDOM_SEED=20260810
SEED_SCALE=medium                # tiny | small | medium | large | xlarge
